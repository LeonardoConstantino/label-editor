{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "./*.d.ts",
    "test/**/*.ts",
    "src/constants/icons.ts.disabled",
    "src/constants/Etiqueta_Padrão_Tactile_Prism.ts"
, "src/domain/services/AssetResolver.ts.disabled"  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
